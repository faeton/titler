# Cloud ASR / review keys for Titler. Copy the lines you have into titler/.env (git-ignored).
# Each provider turns on automatically when its key is present (titler_cloud.available()).

# ElevenLabs Scribe v2 — recommended cloud second hypothesis (word timestamps + keyterms)
ELEVENLABS_API_KEY=
# 1 = send enable_logging=false (zero-retention). Enterprise accounts only; otherwise leave unset.
ELEVENLABS_ZERO_RETENTION=

# Anthropic Claude — text review / adjudication pass (no audio)
ANTHROPIC_API_KEY=
# TITLER_CLAUDE_MODEL=claude-opus-5-5     # or claude-sonnet-5-5 / claude-haiku-5-5
# TITLER_CLAUDE_EFFORT=medium
# TITLER_CLAUDE_FALLBACK=1                # server-side refusal fallback (Opus/Sonnet 5.5)

# Google Gemini API (AI Studio key on a project WITH billing — free tier data is used for training)
GEMINI_API_KEY=

# OpenAI (gpt-transcribe; text only, no timestamps)
OPENAI_API_KEY=

# Soniox (stt-async-v5) — optional third voice, cheapest, per-token language id
SONIOX_API_KEY=
